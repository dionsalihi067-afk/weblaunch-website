# Copy to .env.local for local development. Placeholders only — never commit real values.
# In production (Vercel), set these as Environment Variables for the Production environment.

# --- Email (required) ---------------------------------------------------------
# The contact form returns 503 and sends nothing if any of these is missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_TO=inbox@example.com

# --- Confirmation tokens (strongly recommended) --------------------------------
# Secret for sealing confirmation links. Falls back to SMTP_PASS if unset, which
# invalidates outstanding links whenever the SMTP password changes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_SECRET=

# --- Shared state (required in production) -----------------------------------
# Vercel KV / Upstash Redis REST credentials. Used for single-use confirmation
# links, rate limiting and duplicate detection across serverless instances.
# Production refuses submissions (503) and shows "temporarily unavailable" on
# confirmation pages if these are missing. Development falls back to memory.
# Use a separate database for Preview: set these per environment in Vercel
# (Production scope → production database, Preview scope → preview database).
# Keys are also namespaced by VERCEL_ENV as a safeguard if a database is shared.
# Either pair is accepted:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional -------------------------------------------------------------------
# Max contact submissions per client IP per 10 minutes (default 5).
# CONTACT_RATE_LIMIT_MAX=5

# Development only: origin used in confirmation links when running `next dev`.
# Confirmation link origins on Vercel come from the system variables VERCEL_ENV
# and VERCEL_URL (set automatically — do not define them yourself):
#   Production → always https://www.weblaunchworks.com
#   Preview    → https://<current deployment>.vercel.app
APP_URL=http://localhost:3000
